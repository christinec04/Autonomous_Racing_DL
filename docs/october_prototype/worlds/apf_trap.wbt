#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/factory/containers/protos/WoodenBox.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/robotis/turtlebot/protos/TurtleBot3Burger.proto"

WorldInfo {
  info [
    "Escaping local minima, a hybrid APF and deep reinforcement learning local navigator"
    "The TurtleBot3 Burger follows the potential field until it stalls in the U shaped obstacle, then a PPO agent drives it out."
  ]
  title "APF local minimum trap"
  basicTimeStep 16
}
DEF VIEW Viewpoint {
  orientation 0 0 1 0
  position -4 0 2
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 6 4
  floorTileSize 0.5 0.5
  wallHeight 0.15
}
DEF TRAP_WALL_0 Solid {
  translation 0.65 0 0.11
  children [ Shape { appearance PBRAppearance { baseColor 0.82 0.83 0.86 roughness 0.8 metalness 0 } geometry DEF WALL_0 Box { size 0.1 1.5 0.22 } } ]
  name "trap wall 0"
  boundingObject USE WALL_0
}
DEF TRAP_WALL_1 Solid {
  translation 0.1 0.7 0.11
  children [ Shape { appearance PBRAppearance { baseColor 0.82 0.83 0.86 roughness 0.8 metalness 0 } geometry DEF WALL_1 Box { size 1.2 0.1 0.22 } } ]
  name "trap wall 1"
  boundingObject USE WALL_1
}
DEF TRAP_WALL_2 Solid {
  translation 0.1 -0.7 0.11
  children [ Shape { appearance PBRAppearance { baseColor 0.82 0.83 0.86 roughness 0.8 metalness 0 } geometry DEF WALL_2 Box { size 1.2 0.1 0.22 } } ]
  name "trap wall 2"
  boundingObject USE WALL_2
}
WoodenBox { translation -1.3 1.1 0.15 size 0.3 0.3 0.3 name "box 0" }
WoodenBox { translation -1.0 -1.2 0.15 size 0.3 0.3 0.3 name "box 1" }
WoodenBox { translation 1.6 -1.0 0.15 size 0.3 0.3 0.3 name "box 2" }
WoodenBox { translation 1.5 1.35 0.15 size 0.3 0.3 0.3 name "box 3" }
DEF GOAL Pose {
  translation 2.3 0.0 0
  children [
    Pose { translation 0 0 0.003 children [ Shape { appearance PBRAppearance { baseColor 0.1 0.9 0.4 emissiveColor 0.1 0.9 0.4 transparency 0.35 roughness 1 metalness 0 } geometry Cylinder { height 0.004 radius 0.22 } castShadows FALSE } ] }
    Pose { translation 0 0 0.2 children [ Shape { appearance PBRAppearance { baseColor 0.9 0.9 0.9 roughness 0.5 metalness 0 } geometry Cylinder { height 0.4 radius 0.008 } } ] }
    Pose { translation 0.07 0 0.35 children [ Shape { appearance PBRAppearance { baseColor 0.1 0.9 0.4 emissiveColor 0.1 0.9 0.4 transparency 0 roughness 1 metalness 0 } geometry Box { size 0.14 0.004 0.09 } } ] }
  ]
}
DEF ROBOT TurtleBot3Burger {
  translation 0.28 0.0 0
  rotation 0 0 1 0
  name "TurtleBot3Burger"
  controller "hybrid_apf_drl"
}
