      rotation 0 1 0 1.5708
      children [ Pose { translation -0.012 0 0 children [ Shape { appearance PBRAppearance { baseColor 0.08 0.08 0.09 roughness 0.4 metalness 0 } geometry Box { size 0.03 0.07 0.03 } } ] } ]
      name "overhead camera"
      fieldOfView 1.2
