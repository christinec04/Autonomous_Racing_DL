DEF SUPERVISOR Robot {
  translation 0 0.56 0
  children [
    Pose { translation 0 0 0.5 children [ Shape { appearance PBRAppearance { baseColor 0.2 0.2 0.22 roughness 0.5 metalness 0 } geometry Cylinder { height 1 radius 0.008 } } ] }
    Pose { translation 0 0 0.004 children [ Shape { appearance PBRAppearance { baseColor 0.2 0.2 0.22 roughness 0.5 metalness 0 } geometry Cylinder { height 0.008 radius 0.07 } } ] }
