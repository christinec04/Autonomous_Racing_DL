DEF HAMSTER Robot {
  translation 0.085 0.0 0
  rotation 0 0 1 0
  children [
    Pose { translation 0 0 0.0205 children [ Shape { appearance PBRAppearance { baseColor 0.96 0.96 0.97 roughness 0.25 metalness 0 } geometry Box { size 0.034 0.026 0.029 } } ] }
    Pose { translation 0.0172 0 0.021 children [ Shape { appearance PBRAppearance { baseColor 0.1 0.1 0.12 roughness 0.3 metalness 0 } geometry Box { size 0.001 0.022 0.014 } } ] }
    Pose { translation 0.0178 0.008 0.03 children [ DEF EYE Shape { appearance PBRAppearance { baseColor 0.3 0.8 1 emissiveColor 0.3 0.8 1 transparency 0 roughness 1 metalness 0 } geometry Sphere { radius 0.0022 subdivision 2 } } ] }
    Pose { translation 0.0178 -0.008 0.03 children [ USE EYE ] }
    Pose { translation 0 0 0.0352 children [ Shape { appearance PBRAppearance { baseColorMap ImageTexture { url [ "textures/aruco_4x4_0.png" ] filtering 0 } roughness 1 metalness 0 } geometry Plane { size 0.03 0.03 } } ] }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 0.0155 0.0165 }
      device [ RotationalMotor { name "left wheel motor" maxVelocity 20 } PositionSensor { name "left wheel sensor" } ]
      endPoint Solid {
        translation 0 0.0155 0.0165
        rotation 1 0 0 1.5708
        children [
          Shape { appearance PBRAppearance { baseColor 0.06 0.06 0.07 roughness 0.8 metalness 0 } geometry DEF WHEEL_LEFT Cylinder { height 0.004 radius 0.0165 subdivision 32 } }
          Shape { appearance PBRAppearance { baseColor 0.8 0.8 0.82 roughness 0.4 metalness 0 } geometry Cylinder { height 0.0044 radius 0.008 subdivision 20 } }
        ]
        name "left wheel"
        boundingObject USE WHEEL_LEFT
        physics Physics { density -1 mass 0.003 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 -0.0155 0.0165 }
      device [ RotationalMotor { name "right wheel motor" maxVelocity 20 } PositionSensor { name "right wheel sensor" } ]
      endPoint Solid {
        translation 0 -0.0155 0.0165
        rotation 1 0 0 1.5708
        children [
          Shape { appearance PBRAppearance { baseColor 0.06 0.06 0.07 roughness 0.8 metalness 0 } geometry DEF WHEEL_RIGHT Cylinder { height 0.004 radius 0.0165 subdivision 32 } }
          Shape { appearance PBRAppearance { baseColor 0.8 0.8 0.82 roughness 0.4 metalness 0 } geometry Cylinder { height 0.0044 radius 0.008 subdivision 20 } }
        ]
        name "right wheel"
        boundingObject USE WHEEL_RIGHT
        physics Physics { density -1 mass 0.003 }
      }
    }
    DistanceSensor { translation 0.0175 0.009 0.016 rotation 0 0 1 0.18 name "left proximity" type "infra-red" lookupTable [ 0 255 0, 0.3 0 0 ] }
    DistanceSensor { translation 0.0175 -0.009 0.016 rotation 0 0 1 -0.18 name "right proximity" type "infra-red" lookupTable [ 0 255 0, 0.3 0 0 ] }
    DistanceSensor { translation 0.012 0.006 0.006 rotation 0 1 0 1.5708 name "left floor" type "infra-red" lookupTable [ 0 255 0, 0.02 0 0 ] }
    DistanceSensor { translation 0.012 -0.006 0.006 rotation 0 1 0 1.5708 name "right floor" type "infra-red" lookupTable [ 0 255 0, 0.02 0 0 ] }
    Accelerometer { }
  ]
  name "Hamster"
  boundingObject Group {
    children [
      Pose { translation 0 0 0.0205 children [ Box { size 0.034 0.026 0.029 } ] }
      Pose { translation 0.013 0 0.003 children [ Sphere { radius 0.003 } ] }
      Pose { translation -0.013 0 0.003 children [ Sphere { radius 0.003 } ] }
    ]
  }
  physics Physics { density -1 mass 0.03 }
  controller "hamster_hybrid_apf_drl"
}
